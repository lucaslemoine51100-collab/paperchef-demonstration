      "preparationSteps": [
        {
          "order": 1,
          "text": "Saisir le bœuf en plusieurs fois dans l’huile, puis réserver."
        },
        {
          "order": 2,
          "text": "Faire suer les oignons et les carottes."
        },
        {
          "order": 3,
          "text": "Ajouter la cassonade et mélanger."
        },
        {
          "order": 4,
          "text": "Déglacer avec le vinaigre de vin."
        },
        {
          "order": 5,
          "text": "Remettre la viande, ajouter la farine et mélanger."
        },
        {
          "order": 6,
          "text": "Verser la bière et le bouillon. Ajouter thym et laurier."
        },
        {
          "order": 7,
          "text": "Laisser mijoter jusqu’à ce que la viande soit tendre ; ajouter un peu d’eau chaude si nécessaire."
        },
        {
          "order": 8,
          "text": "Retirer la viande et réduire la sauce si nécessaire."
        },
        {
          "order": 9,
          "text": "Ajouter le pain d’épices et la moutarde, remettre la viande dans la sauce, mélanger puis rectifier l’assaisonnement avant le service."
        }
      ],
